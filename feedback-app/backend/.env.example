FEEDBACK_APP_ENV=development
FEEDBACK_APP_HOST=0.0.0.0
FEEDBACK_APP_PORT=8001
FEEDBACK_AUTH_MODE=mock
# Optional in development; an ephemeral signing key is generated if omitted.
FEEDBACK_AUTH_SECRET=
FEEDBACK_AUTH_TOKEN_TTL_SECONDS=28800
# Optional JSON array; defaults to two reporter test users and one reviewer.
FEEDBACK_MOCK_USERS_JSON=
# For the IAM-private Cloud Run preview, use google_iam instead of mock.
# Complete Google user JWTs must match an approved audience; roles come only from BigQuery.
FEEDBACK_GOOGLE_IAM_AUDIENCES_JSON=[]
# Optional managed-IAP browser identity. Use the exact frontend resource audience;
# leave blank until IAP is enabled on the frontend. The backend remains IAM-private.
FEEDBACK_GOOGLE_IAP_AUDIENCE=
FEEDBACK_GOOGLE_IAM_DOMAINS=loreal.com
FEEDBACK_AUTHZ_TABLE=oa-apmena-techsandbox-ap-dv.agent_quality.application_access_grants
# Grant changes/revocations take effect within at most 30 seconds; 0 disables the cache.
FEEDBACK_AUTHZ_CACHE_TTL_SECONDS=30
# FEEDBACK_GOOGLE_IAM_USERS_JSON is deprecated migration input, never a runtime fallback.
# private_demo is sandbox-only: real Google reviewer grant + explicit presenter
# allowlist are required before the original reviewer/reporter picker is enabled.
FEEDBACK_PRIVATE_DEMO_PRESENTERS=
# Existing IAP app only. Demo Admin remains an application grant, not an auth mode.
# Requests select agent_quality_demo locally; the primary grant lookup remains live.
FEEDBACK_ROLE_DEMO_ENABLED=false
FEEDBACK_DEMO_FRONTEND_ORIGIN=
GCP_PROJECT_ID=oa-apmena-techsandbox-ap-dv
BIGQUERY_DATASET=agent_quality
BIGQUERY_LOCATION=europe-west1
FEEDBACK_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
FEEDBACK_ALLOW_ALL_ORIGINS=true
DEFAULT_AGENT_ID=neo-rules-agent
# Legacy evaluation agent base URL. Do not point this at Graph Builder.
NEO_AGENT_API_URL=
# Server-owned targets. Blank means retests are disabled (no fabricated answers).
# Example: [{"id":"neo-nonprod","agent_id":"neo-rules-agent","environment":"nonprod","label":"NEO non-production","url":"https://YOUR-AGENT/api/agent/runs","auth":"google_id_token","audience":"https://YOUR-AGENT","version":"release-id"}]
# Supported auth: none, bearer_env (token_env names a secret env var), google_id_token, google_access_token.
# Protocol defaults to quality_json. For the NEO API used by the Excel pipeline:
# [{"id":"neo-nonprod","environment":"nonprod","label":"NEO · Non-production","protocol":"neo_companion","url":"https://api.loreal.net/global/it4it/btdp-genaiengine/v1/contexts/neo_nasapmena-8ec4bd70-np/configs/default/generations","auth":"google_access_token","timeout_seconds":300},{"id":"neo-prod","environment":"prod","label":"NEO · Production"}]
# google_access_token refreshes backend application-default credentials, never browser tokens.
# neo_companion creates a new conversation per retest; do not pass an old conversation ID.
# Generation POSTs are not automatically replayed after a timeout or upstream failure.
FEEDBACK_AGENT_TARGETS_JSON=
# Optional: impersonate this server-owned identity only for the exact neo-prod NEO Companion target.
# Requires the API runtime identity to have iam.serviceAccounts.getAccessToken on this service account.
# All other targets and BQ/Secret Manager/RCA operations continue to use the API runtime identity.
FEEDBACK_NEO_COMPANION_PROD_SERVICE_ACCOUNT=
# All environments use the same authenticated reviewer permissions.
# The former FEEDBACK_PROD_RETEST_REVIEWERS setting is deprecated and ignored.
FEEDBACK_READ_CACHE_TTL_SECONDS=30
FEEDBACK_WORKER_ENABLED=true
FEEDBACK_WORKER_POLL_SECONDS=15
# Feedback RCA/domain inference uses the completed Neo4j corpus, never an automatic local fallback.
FEEDBACK_EVIDENCE_BACKEND=neo4j
# Optional absolute server-only .env path for existing Neo4j/OpenAI credentials.
# The adapter reads only needed values; it does not load that file into the process environment.
FEEDBACK_NEO4J_ENV_FILE=
# Alternatively supply these directly, ideally from a secret manager and with a read-only graph user.
FEEDBACK_NEO4J_URI=
FEEDBACK_NEO4J_USERNAME=
FEEDBACK_NEO4J_PASSWORD=
FEEDBACK_NEO4J_DATABASE=neo4j
FEEDBACK_NEO4J_DOCUMENT_PREFIX=NEO_RCA-VisualAnalysis__
FEEDBACK_NEO4J_VECTOR_INDEX=vector
FEEDBACK_NEO4J_FULLTEXT_INDEX=keyword
# Mount/copy the ingestion manifest for exact original filenames, parser and parsed-GCS provenance.
# This is metadata only: all searchable source text and ranking remain in Neo4j.
FEEDBACK_NEO4J_SOURCE_MANIFEST=
# Optional pin to the manifest fingerprint reported by scripts.check_neo4j_evidence.
FEEDBACK_NEO4J_CORPUS_VERSION=
# Query embeddings must match ingestion. Blank values can inherit from FEEDBACK_NEO4J_ENV_FILE.
FEEDBACK_EVIDENCE_EMBEDDING_MODEL=
FEEDBACK_EVIDENCE_EMBEDDING_API_KEY=
FEEDBACK_EVIDENCE_EMBEDDING_BASE_URL=
FEEDBACK_EVIDENCE_QUERY_TIMEOUT_SECONDS=20
# Legacy BM25 compatibility settings. Used only after explicitly selecting backend=bm25;
# Neo4j failures NEVER load these collections or local directories.
FEEDBACK_EVIDENCE_VERSION=
NEO_VLM_GCS_URI=gs://oa-apmena-techsandbox-ap-dv-neo-rca-vlm-docs/parsed_docs_vlm
NEO_FAST_GCS_URI=gs://oa-apmena-techsandbox-ap-dv-neo-rca-vlm-docs/parsed_docs_fast
# Optional legacy local directories; GCS is used when the corresponding URI is set.
NEO_FAST_DOCS_DIR=
NEO_VLM_DOCS_DIR=
BTAP_GATEWAY_URL=https://x-np.api.loreal.net/global/it4it/btapgateways-aigateway/v1
BTAP_MODEL=claude-sonnet-4-6
# Optional explicit RCA gateway identity. This is separate from Production NEO impersonation.
# Runtime ADC must be allowed to mint access tokens for this SA; no key/token is stored here.
# Do not set BTAP_ACCESS_TOKEN as well. A failed impersonation never falls back to another identity.
BTAP_SERVICE_ACCOUNT=
# Optional; if omitted, RCA suggestions request a local gcloud access token.
BTAP_ACCESS_TOKEN=
# Hosts approved by the operator for reviewer-configured environment endpoints.
# Saving an environment cannot add hosts to this allowlist. No credentials here.
FEEDBACK_AGENT_ALLOWED_HOSTS=api.loreal.net
FEEDBACK_PROMOTION_BATCH_LIMIT=500
