# Browser requests use the Vite proxy in development when this is empty.
# Set this when the FastAPI service is hosted separately.
VITE_API_URL=""
# Local only. The deployment Dockerfile explicitly builds google_iam instead.
VITE_AUTH_MODE=mock
# Hosted private presenter demo builds explicitly use VITE_AUTH_MODE=private_demo.
# In-app Demo Admin uses the normal google_iam build. No new VITE auth mode/password.
# The hosted server enables FEEDBACK_ROLE_DEMO_ENABLED; capabilities come from the API.
